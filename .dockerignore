!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!README.md
!LICENSE
!pricing.yaml
!.python-version
!src/
!src/**
!configs/
!configs/**
!eval/
!eval/**
!scripts/
!scripts/**
!examples/
!examples/**

**/__pycache__/
**/*.py[cod]
**/*.local.toml
**/*.sbatch
**/*.pbs
**/.env*
**/*.jsonl
**/*.parquet
**/runs/
**/results/
**/outputs/
**/logs/
**/wandb/
**/gifs/
**/*.safetensors
**/*.distcp
eval/figures/
eval/*.ipynb
