# Local OpenAI-compatible servers accept any non-empty key.
OPENAI_API_KEY_LOCAL=EMPTY

# Optional hosted providers. Uncomment only the services you use.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_RESPONSES_ENDPOINT=
# HF_TOKEN=

# Optional destination used only by scripts/upload_assets.py.
# GLYPHBENCH_ASSET_REPO=owner/dataset-name

# Optional experiment tracking.
# WANDB_API_KEY=
# WANDB_ENTITY=
